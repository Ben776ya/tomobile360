# Analytics — GA4 measurement ID (G-XXXXXXXXXX). Leave blank to disable GA4
# entirely (loader renders nothing, all lead events no-op). Set in Vercel too.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Business identity (USER_REQUIRED — see USER_DATA_REQUIRED.md once generated)
NEXT_PUBLIC_RC_NUMBER=
NEXT_PUBLIC_ICE_NUMBER=
NEXT_PUBLIC_DIRECTOR_NAME=
NEXT_PUBLIC_CAPITAL_SOCIAL=
NEXT_PUBLIC_CNDP_DECLARATION=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
NEXT_PUBLIC_WHATSAPP_E164=

# Instagram — long-lived Instagram User access token (Instagram API with
# Instagram Login, permission instagram_business_basic) for @tomobile360.ma.
# Server-only. When set, the homepage reels panel lists the latest reels
# automatically and plays them natively; when blank (or the API fails) it
# shows the curated reel list in src/lib/instagram.ts via Instagram's embed.
# Long-lived tokens expire after 60 days unless refreshed.
INSTAGRAM_ACCESS_TOKEN=
