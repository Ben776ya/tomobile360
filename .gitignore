migrations/

# legacy scripts (keep out of version control)
scripts/*
!scripts/audit-internal-links.ts
!scripts/validate-content.ts
# not legacy: the only supported way to create staff accounts and rotate
# passwords (no signup flow, no self-service reset, no SMTP configured)
!scripts/create-staff-user.mjs
!scripts/fix-broken-links.ts
# guards the article editor against the live content (npm run check:editor-compat)
!scripts/check-article-editor-compat.ts
!scripts/extract-magazine-cover.py
!scripts/compress-magazine-pdf.py
!scripts/upload-magazines-to-supabase.mjs
!scripts/prelaunch-scan.sh
!scripts/convert-png-to-webp.mjs
!scripts/import-curated-with-fiches.mjs
!scripts/map-videos-to-models.ts
!scripts/lib/
!scripts/output/
